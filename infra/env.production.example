# Production env file. Keep it outside the deploy path, e.g. /etc/rag-agent/rag-agent.env.
# The compose file overrides MILVUS_URI and OLLAMA_HOST for the container, so the
# values here only matter for tooling that runs on the host.

RAG_AGENT_HTTP_BIND=127.0.0.1
RAG_AGENT_HTTP_PORT=9229
CORS_ORIGINS=https://chat.rag-agent.example,https://pis3.aempro.ca

RAG_COLLECTION_NAME=rag_documents_v2
RAG_LLM_MODEL=qwen3.6
DENSE_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_TOP_K=4

MILVUS_DB=rag2
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

LOG_LEVEL=INFO

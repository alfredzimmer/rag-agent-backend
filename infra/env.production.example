RAG_AGENT_HTTP_BIND=127.0.0.1
RAG_AGENT_HTTP_PORT=9229
RAG_AGENT_RELOAD=false
CORS_ORIGINS=https://chat.rag-agent.example,https://pis3.aempro.ca
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

RAG_COLLECTION_NAME=HeaderInContentTrial
RAG_GLOBAL_SCOPE=global
RAG_LLM_MODEL=qwen3.6
DENSE_EMBEDDING_MODEL=nomic-embed-text:latest
SIMPLE_RAG=true

JWT_SECRET_KEY=replace-with-a-long-random-secret

POSTGRES_USER=rag_agent
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=rag_agent
PG_URI=postgresql://rag_agent:replace-with-a-url-safe-password@postgres:5432/rag_agent

REDIS_URL=redis://redis:6379/0

MILVUS_URI=http://milvus:19530
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_DB=rag1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_HOST=minio
MINIO_PORT=9000

OLLAMA_HOST=http://host.docker.internal:11434

INGESTION_STREAM=rag-agent:ingestion:jobs
INGESTION_CONSUMER_GROUP=rag-agent-ingestion-workers
INGESTION_DEAD_LETTER_STREAM=rag-agent:ingestion:dead-letter
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=150
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_AFTER_MS=900000
INGESTION_LOCK_TTL_MS=7200000
INGESTION_MAX_UPLOAD_BYTES=52428800
INGESTION_DELETE_SOURCE_ON_SUCCESS=false

OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
LOG_LEVEL=INFO

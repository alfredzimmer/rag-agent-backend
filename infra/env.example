# Dev setup: Docker runs Milvus, the API runs on the host with uv.
#   cp infra/env.example .env

RAG_AGENT_PORT=9229
RAG_AGENT_RELOAD=false
CORS_ORIGINS=https://chat.rag-agent.example,https://pis3.aempro.ca,http://localhost:3000,http://localhost:5173

RAG_COLLECTION_NAME=rag_documents
RAG_LLM_MODEL=qwen3.6:latest
RAG_LLM_NUM_PREDICT=8192
RAG_LLM_REASONING=false
DENSE_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_TOP_K=4

# Retrieval reranking. "none" (default) is single-pass dense search. "mmr"
# over-fetches RAG_FETCH_K candidates and drops near-duplicates; "llm" reranks
# them with the resident chat model. See docs/RETRIEVAL.md.
RAG_RERANK_BACKEND=none
RAG_FETCH_K=40
RAG_MMR_LAMBDA=0.5

MILVUS_URI=http://localhost:19530
MILVUS_DB=default
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

OLLAMA_HOST=http://localhost:11434

LOG_LEVEL=INFO

# Dev setup: Docker runs dependencies, Edemi Backend runs on the host with uv.
# Copy to both:
#   cp infra/env.example infra/.env
#   cp infra/env.example .env

EDEMI_PORT=9229
RAG_COLLECTION_NAME=HeaderInContentTrial
RAG_LLM_MODEL=qwen3.6
JWT_SECRET_KEY=generate-a-long-random-value
DEFAULT_USER_PASSWORD=choose-a-strong-initial-password

POSTGRES_USER=edemi
POSTGRES_PASSWORD=thisisdifferentontheserver
POSTGRES_DB=edemi
PG_URI=postgresql://edemi:change-me@localhost:5433/edemi

MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=rag1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=/root/.ollama

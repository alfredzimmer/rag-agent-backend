# Dev setup: Docker runs Milvus, the API runs on the host with uv.
#   cp infra/env.example .env

RAG_AGENT_PORT=9229
RAG_AGENT_RELOAD=false
CORS_ORIGINS=https://chat.rag-agent.example,https://pis3.aempro.ca,http://localhost:3000,http://localhost:5173

RAG_COLLECTION_NAME=rag_documents
RAG_LLM_MODEL=qwen3.6:latest
DENSE_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_TOP_K=4

MILVUS_URI=http://localhost:19530
MILVUS_DB=default
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

OLLAMA_HOST=http://localhost:11434

LOG_LEVEL=INFO

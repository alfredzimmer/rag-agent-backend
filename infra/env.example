# Dev setup: Docker runs dependencies, Edemi Backend runs on the host with uv.
# Copy to both:
#   cp infra/env.example infra/.env
#   cp infra/env.example .env

EDEMI_PORT=9229
EDEMI_RELOAD=false
RAG_COLLECTION_NAME=HeaderInContentTrial
RAG_LLM_MODEL=qwen3.6
JWT_SECRET_KEY=generate-a-long-random-value

POSTGRES_USER=edemi
POSTGRES_PASSWORD=thisisdifferentontheserver
POSTGRES_DB=edemi
PG_URI=postgresql://edemi:change-me@localhost:5433/edemi

MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=rag1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_HOST=localhost
MINIO_PORT=9000

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=/root/.ollama

REDIS_URL=redis://localhost:6380/0
INGESTION_UPLOAD_DIR=.runtime/uploads
INGESTION_STREAM=edemi:ingestion:jobs
INGESTION_CONSUMER_GROUP=edemi-ingestion-workers
INGESTION_DEAD_LETTER_STREAM=edemi:ingestion:dead-letter
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=150
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_AFTER_MS=900000
INGESTION_LOCK_TTL_MS=7200000
INGESTION_MAX_UPLOAD_BYTES=52428800
INGESTION_DELETE_SOURCE_ON_SUCCESS=false
RAG_GLOBAL_SCOPE=global

OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=INFO
